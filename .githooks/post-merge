#!/bin/sh
# Después de un merge, regenera el progreso del curso y la navegación de docs/flow
# (el marcador "← esta rama" depende de la rama) y, si algo cambia, lo guarda en un
# commit aparte. Git no deja modificar el contenido del propio commit de merge.
root=$(git rev-parse --show-toplevel)
changed=$(python3 "$root/tools/docs/progress.py") || exit 1
[ -z "$changed" ] && exit 0
echo "$changed"
echo "$changed" | sed 's/^actualizado //' | (cd "$root" && xargs git add --)
# Durante post-merge Git aún conserva el estado del merge, así que "git commit" crearía
# un segundo merge; el commit se arma a mano con un solo padre (HEAD).
cd "$root" || exit 1
commit=$(git commit-tree "$(git write-tree)" -p HEAD -m "Update course progress after merge" -m "Generated by tools/docs/progress.py.") &&
  git update-ref -m "post-merge: update course progress" HEAD "$commit"
